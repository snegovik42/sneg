# Симулятор кейсов на sneg
# Показывает таблицы, функции, случайность и изменение состояния объекта.

let стартовый = {
    имя: "Стартовый",
    цена: 100,
    предметы: [
        { имя: "Бизон | Городская угроза", вес: 40, цена: 20 },
        { имя: "MP9 | Песчаная буря", вес: 25, цена: 15 },
        { имя: "UMP-45 | Лабиринт", вес: 18, цена: 60 },
        { имя: "AK-47 | Синий ламинат", вес: 10, цена: 100 },
        { имя: "M4A1-S | Ночной ужас", вес: 5, цена: 280 },
        { имя: "Револьвер R8 | Безумная восьмёрка", вес: 1.5, цена: 400 },
        { имя: "AWP | Азимов", вес: 0.5, цена: 1200 }
    ]
}

fn сумма_весов(c) {
    let total = 0
    for item in c.предметы {
        total += item.вес
    }
    return total
}

# прокрут: берём случайную точку на отрезке весов и ищем, в чьё «окно» попали
fn прокрут(c) {
    let точка = random() * сумма_весов(c)
    let накоплено = 0

    for item in c.предметы {
        накоплено += item.вес
        if точка <= накоплено {
            return item
        }
    }
    return c.предметы[len(c.предметы) - 1]
}

# сколько в среднем возвращает одно открытие
fn матожидание(c) {
    let total = сумма_весов(c)
    let сумма = 0
    for item in c.предметы {
        сумма += item.цена * item.вес
    }
    return сумма / total
}

fn открыть(игрок, c) {
    if игрок.баланс < c.цена {
        print("  не хватает денег:", игрок.баланс, "из", c.цена)
        return nil
    }

    игрок.баланс -= c.цена
    let дроп = прокрут(c)
    push(игрок.лут, дроп)
    игрок.потрачено += c.цена
    игрок.выпало += дроп.цена

    let знак = "+"
    if дроп.цена < c.цена {
        знак = "-"
    }
    print("  выпало:", дроп.имя, "·", дроп.цена, "₽", знак)

    return дроп
}

let игрок = {
    имя: "sneg",
    баланс: 1000,
    лут: [],
    потрачено: 0,
    выпало: 0
}

print("Кейс:", стартовый.имя, "·", стартовый.цена, "₽")
print("Матожидание одного открытия:", round(матожидание(стартовый)), "₽")
print("Возврат:", round(матожидание(стартовый) / стартовый.цена * 100), "% от цены")
print()

for i in range(0, 5) {
    print("Открытие", i + 1)
    открыть(игрок, стартовый)
}

print()
print("Баланс:", игрок.баланс, "₽")
print("Потрачено:", игрок.потрачено, "₽")
print("Выпало на:", игрок.выпало, "₽")

let итог = игрок.выпало - игрок.потрачено
if итог >= 0 {
    print("Итог: плюс", итог, "₽")
} else {
    print("Итог: минус", -итог, "₽")
}

print()
print("Что в инвентаре:")
for item in игрок.лут {
    print("  ·", item.имя)
}
