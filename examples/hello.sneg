# Первая программа на sneg
print("привет, мир")
print(2 + 2)

let имя = "sneg"
print("привет, " + имя + "!")

fn квадрат(x) {
    return x * x
}

print("квадрат семи =", квадрат(7))

# списки и таблицы
let оценки = [5, 4, 3, 5, 4]
print("оценки:", оценки, "длина:", len(оценки))

let игрок = { имя: "sneg", баланс: 1000, живой: true }
print("игрок:", игрок)
print("баланс:", игрок.баланс)

# цикл
let сумма = 0
for оценка in оценки {
    сумма += оценка
}
print("средний балл:", сумма / len(оценки))
