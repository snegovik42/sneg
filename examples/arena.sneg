# Арена: два бойца бьют друг друга по очереди.
# Показывает таблицы как объекты, случайность и цикл с условием выхода.

fn создать_бойца(имя, hp, урон) {
    return {
        имя: имя,
        hp: hp,
        максимум: hp,
        урон: урон
    }
}

fn атаковать(кто, кого) {
    let крит = chance(20)                  # 20% шанс на критический удар
    let урон = кто.урон + randint(0, 3)

    if крит {
        урон = урон * 2
    }

    кого.hp -= урон
    if кого.hp < 0 {
        кого.hp = 0
    }

    let пометка = ""
    if крит {
        пометка = " КРИТ!"
    }

    print(" ", кто.имя, "бьёт на", урон, "·", кого.имя, "—", кого.hp, "hp" + пометка)
}

fn полоска(hp, максимум) {
    let длина = 20
    let заполнено = round(hp / максимум * длина)
    let строка = ""
    for i in range(0, длина) {
        if i < заполнено {
            строка += "█"
        } else {
            строка += "░"
        }
    }
    return строка
}

let герой = создать_бойца("sneg", 100, 12)
let враг = создать_бойца("Кейс-Босс", 120, 10)

print("⚔  " + герой.имя + " против " + враг.имя)
print()

let раунд = 0

while герой.hp > 0 and враг.hp > 0 {
    раунд += 1
    print("Раунд " + раунд)

    атаковать(герой, враг)
    if враг.hp <= 0 {
        break
    }
    атаковать(враг, герой)
    print()
}

print()
if герой.hp > 0 {
    print("🏆 Победа! Осталось", герой.hp, "hp из", герой.максимум)
} else {
    print("💀 Поражение. Босс остался с", враг.hp, "hp")
}

print(герой.имя, полоска(герой.hp, герой.максимум))
print(враг.имя, полоска(враг.hp, враг.максимум))
