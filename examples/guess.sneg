# Угадай число — интерактивная программа.
# Запуск: python sneg.py examples/guess.sneg

let загадано = randint(1, 100)
let попыток = 0

print("Я загадал число от 1 до 100.")

while true {
    let ввод = input("твой вариант: ")

    if ввод == nil {
        print("Ввод закончился — выхожу.")
        break
    }

    let число = num(ввод)
    if число == nil {
        print("Это не число, попробуй ещё раз.")
        continue
    }

    попыток += 1

    if число < загадано {
        print("больше")
    } elseif число > загадано {
        print("меньше")
    } else {
        print("Угадал! Попыток:", попыток)
        break
    }
}
